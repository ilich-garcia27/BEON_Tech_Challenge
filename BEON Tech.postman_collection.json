  "item": [
    {
      "name": "Create Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Validating response code.\r\n\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n\r\n    pm.collectionVariables.set(\"token\", pm.response.json().token);\r\n});\r\n\r\n// Validating request and response body.\r\n\r\npm.test(\"Request schema is correct and exists\", function () {\r\n    const schemas = JSON.parse(pm.collectionVariables.get(\"schemas\"));\r\n    const request = JSON.parse(pm.request.body.raw);\r\n\r\n    pm.expect(request).to.have.jsonSchema(schemas.AuthenticationRequestDto);\r\n});\r\n\r\npm.test(\"Response schema is correct and exists\", function () {\r\n    const schemas = JSON.parse(pm.collectionVariables.get(\"schemas\"));\r\n\r\n    pm.response.to.have.jsonSchema(schemas.AuthenticationResponseDto);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"username\": \"{{username}}\",\r\n    \"password\": \"{{password}}\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Validating response code.\r\n\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n\r\n    pm.collectionVariables.set(\"bookingid\", pm.response.json().bookingid);\r\n});\r\n\r\n// Validating request and response body.\r\n\r\npm.test(\"Request schema is correct and exists\", function () {\r\n    const schemas = JSON.parse(pm.collectionVariables.get(\"schemas\"));\r\n    const request = JSON.parse(pm.request.body.raw);\r\n\r\n    pm.expect(request).to.have.jsonSchema(schemas.CreateBookingRequestDto);\r\n});\r\n\r\npm.test(\"Response schema is correct and exists\", function () {\r\n    const schemas = JSON.parse(pm.collectionVariables.get(\"schemas\"));\r\n\r\n    pm.response.to.have.jsonSchema(schemas.CreateBookingResponseDto);\r\n});\r\n\r\npm.test(\"Data sent matches with response body\", function () {\r\n    pm.expect(JSON.parse(pm.request.body.raw)).to.eql(pm.response.json().booking);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
