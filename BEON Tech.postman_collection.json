  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "const definitions = {\r",
          "    BookingItemDto: {\r",
          "        \"required\": [\"firstname\", \"lastname\", \"totalprice\", \"depositpaid\", \"bookingdates\", \"additionalneeds\"],\r",
          "        \"additionalProperties\": false,\r",
          "        \"properties\": {\r",
          "            \"firstname\": {\r",
          "                \"type\": \"string\"\r",
          "            },\r",
          "            \"lastname\": {\r",
          "                \"type\": \"string\"\r",
          "            },\r",
          "            \"totalprice\": {\r",
          "                \"type\": \"number\"\r",
          "            },\r",
          "            \"depositpaid\": {\r",
          "                \"type\": \"boolean\"\r",
          "            },\r",
          "            \"bookingdates\": {\r",
          "                \"type\": \"object\",\r",
          "                \"required\": [\"checkin\", \"checkout\"],\r",
          "                \"additionalProperties\": false,\r",
          "                \"properties\": {\r",
          "                    \"checkin\": {\r",
          "                        \"type\": \"string\"\r",
          "                    },\r",
          "                    \"checkout\": {\r",
          "                        \"type\": \"string\"\r",
          "                    }\r",
          "                }\r",
          "            },\r",
          "            \"additionalneeds\": {\r",
          "                \"type\": \"string\"\r",
          "            }\r",
          "        }\r",
          "    }\r",
          "}\r",
          "\r",
          "const schemas = {\r",
          "    AuthenticationRequestDto: {\r",
          "        \"type\": \"object\",\r",
          "        \"required\": [\"username\", \"password\"],\r",
          "        \"additionalProperties\": false,\r",
          "        \"properties\": {\r",
          "            \"username\": {\r",
          "                \"type\": \"string\"\r",
          "            },\r",
          "            \"password\": {\r",
          "                \"type\": \"string\"\r",
          "            }\r",
          "        }\r",
          "    },\r",
          "    AuthenticationResponseDto: {\r",
          "        \"type\": \"object\",\r",
          "        \"additionalProperties\": false,\r",
          "        \"required\": [\"token\"],\r",
          "        \"properties\": {\r",
          "            \"token\": {\r",
          "                \"type\": \"string\"\r",
          "            }\r",
          "        }\r",
          "    },\r",
          "    CreateBookingRequestDto: {\r",
          "        definitions,\r",
          "        $ref: \"#/definitions/BookingItemDto\"\r",
          "    },\r",
          "    CreateBookingResponseDto: {\r",
          "        definitions,\r",
          "        \"type\": \"object\",\r",
          "        \"required\": [\"bookingid\", \"booking\"],\r",
          "        \"additionalProperties\": false,\r",
          "        \"properties\": {\r",
          "            \"bookingid\": {\r",
          "                \"type\": \"number\"\r",
          "            },\r",
          "            \"booking\": {\r",
          "                $ref: \"#/definitions/BookingItemDto\"\r",
          "            },\r",
          "        }\r",
          "    },\r",
          "    GetBookingResponseDto: {\r",
          "        definitions,\r",
          "        $ref: \"#/definitions/BookingItemDto\"\r",
          "    },\r",
          "    UpdateBookingRequestDto: {\r",
          "        definitions,\r",
          "        $ref: \"#/definitions/BookingItemDto\"\r",
          "    },\r",
          "    UpdateBookingResponseDto: {\r",
          "        definitions,\r",
          "        $ref: \"#/definitions/BookingItemDto\"\r",
          "    }\r",
          "}\r",
          "\r",
          "pm.collectionVariables.set(\"schemas\", JSON.stringify(schemas));"
        ],
        "type": "text/javascript"
      }
    },
